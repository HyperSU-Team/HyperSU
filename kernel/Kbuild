ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

# ---------------------------------------------------------------------------
# Capability probes
#
# These detect kernel internals the sources must adapt to. They run for GKI and
# legacy kernels alike: the probes only define feature macros, and each consumer
# picks the branch it needs. The object set is decided earlier, by KSU_IS_NON_GKI.
# ---------------------------------------------------------------------------
