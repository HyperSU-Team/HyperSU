# ---------------------------------------------------------------------------
# Legacy kernel (Linux < 5.10) support
#
# The compat/ sources replace the native SELinux-hide implementation on kernels
# that predate the GKI facilities it relies on. They are linked into the same
# module as the rest of the sources, not built as a separate object directory:
# they call into module-internal symbols (ksu_lsm_hook, ksu_patch_text,
# ksu_register_feature_handler, ...), which a separate module could not resolve.
#
# Selection is by kernel version; GKI kernels keep the native object set and are
# unaffected. See the capability probes further down for the feature switches.
#
# The object swap itself happens after every kernelsu-objs line below, because
# the native selinux_hide.o is added further down.
# ---------------------------------------------------------------------------
KSU_IS_NON_GKI := $(shell test $(VERSION) -lt 5 -o \( $(VERSION) -eq 5 -a $(PATCHLEVEL) -lt 10 \); echo $$?)

ifeq ($(KSU_IS_NON_GKI),0)
ccflags-y += -DKSU_NON_GKI

kernelsu-objs += compat/selinux_hide.o
kernelsu-objs += compat/rules.o
kernelsu-objs += compat/sepolicy.o
kernelsu-objs += compat/symbol_resolver.o
ifeq ($(CONFIG_ARM64),y)
kernelsu-objs += compat/patch_memory_arm64.o
endif
# Provides path_mount()/path_umount()/ext4_unregister_sysfs() shims for kernels
# that predate them (path_mount arrived in 5.9). feature/kernel_umount.c and
# infra/su_mount_ns.c call those symbols unconditionally.
kernelsu-objs += infra/kernel_compat.o

$(info -- $(REPO_NAME): legacy kernel $(KERNEL_VERSION) detected, using compat/ sources)
else
$(info -- $(REPO_NAME): GKI kernel $(KERNEL_VERSION) detected, using native sources)
endif

kernelsu-objs += feature/adb_root.o

kernelsu-objs += feature/selinux_hide.o
kernelsu-objs += feature/shell_su_adb_only.o

kernelsu-objs += feature/uts_spoof.o

kernelsu-objs += feature/cpu_spoof.o

# Resolve the native/compat overlap now that every kernelsu-objs line has been
# evaluated. Both implementations define the same symbols (ksu_selinux_hide_*,
# my_write_context, my_setprocattr, ksu_patch_text, apply_kernelsu_rules, ...),
# so exactly one set may be linked.
#
# compat/{rules,sepolicy,symbol_resolver}.c are the legacy-kernel ports of
# selinux/{rules,sepolicy}.c and infra/symbol_resolver.c. They carry the
# pre-5.10 SELinux internal layout handling that the native versions do not
# have (the native ones only branch on 6.4), so they replace, not supplement,
# their counterparts.
ifeq ($(KSU_IS_NON_GKI),0)
kernelsu-objs := $(filter-out feature/selinux_hide.o,$(kernelsu-objs))
kernelsu-objs := $(filter-out hook/arm64/patch_memory.o,$(kernelsu-objs))
kernelsu-objs := $(filter-out selinux/rules.o,$(kernelsu-objs))
kernelsu-objs := $(filter-out selinux/sepolicy.o,$(kernelsu-objs))
kernelsu-objs := $(filter-out infra/symbol_resolver.o,$(kernelsu-objs))
endif

