# MODULE_IMPORT_NS() arrived in 5.4 (8651ec01daedad). Before that it does not
# exist at all, and core/init.c used to reach the else branch of a bare
# `>= 6.13` test, so the token parsed as an implicit-int function declaration
# and -Werror stopped the build. Emitting MODULE_INFO(import_ns, ...) on such a
# kernel would be no better: nothing consumes that section, and the quoted form
# is a 6.13 change to the macro's own argument handling.
ifeq ($(shell grep -q "define MODULE_IMPORT_NS" $(srctree)/include/linux/module.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_MODULE_IMPORT_NS
endif

# struct file_operations members that infra/file_wrapper.c mirrors. It has to
# copy every slot the original file may use, but the slots themselves are not
# stable across the range of kernels this tree builds on, and a version test
# alone cannot decide: 4.19 has neither, and vendor trees backport members out
# of order. Probe the struct instead.
ifeq ($(shell grep -q "(\*iopoll)" $(srctree)/include/linux/fs.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_IOPOLL
endif

# remap_file_range replaced clone_file_range/dedupe_file_range in 4.20. Before
# that the two old slots are what the VFS calls, so the wrapper has to mirror
# them separately and there is no REMAP_FILE_DEDUP flag to branch on.
ifeq ($(shell grep -q "(\*remap_file_range)" $(srctree)/include/linux/fs.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_REMAP_FILE_RANGE
endif

# The seccomp action cache arrived in 5.9 (0eebfedec05d). Before that
# seccomp_run_filters() always walks the whole filter chain and
# struct seccomp_filter has no bitmap to short-circuit with, so
# infra/seccomp_cache.c has nothing to write to and compiles to no-ops.
ifeq ($(shell grep -q "SECCOMP_ARCH_NATIVE_NR" $(srctree)/kernel/seccomp.c; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_SECCOMP_ACTION_CACHE
endif

ifeq ($(shell grep -q "selinux_cred" $(srctree)/security/selinux/include/objsec.h; echo $$?),0)
ccflags-y += -DKSU_HAS_SELINUX_CRED
endif

ifeq ($(shell grep -q "struct type_datum \*\*type_val_to_struct;" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_TYPE_VAL_TO_STRUCT
endif

# half-assed-backport from 5.1
ifeq ($(shell grep -q "struct type_datum \*\*type_val_to_struct_array;" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_TYPE_VAL_TO_STRUCT_ARRAY
endif

# https://github.com/torvalds/linux/commit/11276d5306b8e5b438a36bbff855fe792d7eaa61
ifeq ($(shell grep -q "DEFINE_STATIC_KEY_TRUE" $(srctree)/include/linux/jump_label.h 2>/dev/null; echo $$?),0)
$(info -- $(REPO_NAME)/compat: modern static_key_interface found)
ccflags-y += -DKSU_HAS_MODERN_STATIC_KEY_INTERFACE
endif

